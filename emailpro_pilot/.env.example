# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave unset to use local SQLite (pilot default).
# For Postgres later: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Gemini classification ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Gmail SMTP sending ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SENDER_NAME=EmailPro Pilot

# Conservative default: 20 sends per minute
SEND_RATE_PER_MINUTE=20
